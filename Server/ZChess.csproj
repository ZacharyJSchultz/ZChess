<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client.Core" Version="10.0.14" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Common" Version="10.0.14" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.Json" Version="10.0.14" />
		<PackageReference Include="NTypewriter.SourceGenerator" Version="0.5.9" />
		<PackageReference Include="NTypewriter.Editor.Config" Version="0.5.9" />
	</ItemGroup>

	<ItemGroup>
		<None Update="GenFiles\tsclassgen.nt">
			<CustomToolNamespace>e259cdaa-0723-45a0-b8af-80efdca37a90</CustomToolNamespace>
		</None>
		<None Update="GenFiles\tsenumgen.nt">
			<CustomToolNamespace>2a7bf848-97e7-47e9-bc2b-db4b915eef80</CustomToolNamespace>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Controllers\" />
	</ItemGroup>

	<Target Name="ClearGeneratedTsFiles" BeforeTargets="Build">
		<Message Text="Clearing Generated TS Files..." />
		<Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)Scripts\Clear-GeneratedTsFiles.ps1&quot;"
			  WorkingDirectory="$(ProjectDir)" />
	</Target>

</Project>
